{
  "name": "web-discover",
  "version": "1.0.0",
  "description": "Explore websites, capture observed journeys and evidence, and export GraphWalker model drafts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "web-discover": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "check": "tsc --project tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "pretest": "npm run build",
    "prepare": "npm run build",
    "test:package": "npm run build && node scripts/test-package.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "crawlee": "3.18.2",
    "fast-xml-parser": "5.11.2",
    "playwright": "1.64.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattlock83/web-discover.git"
  },
  "homepage": "https://github.com/mattlock83/web-discover#readme",
  "bugs": {
    "url": "https://github.com/mattlock83/web-discover/issues"
  }
}
